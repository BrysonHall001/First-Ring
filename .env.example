# Copy to .env locally, or set these in Render's Environment tab in production.
# Simulation mode needs NONE of the Vapi vars.

# Shared secret between AST and this server (both directions)
AST_SHARED_KEY=change-me-to-something-long-and-random

PORT=3000

# --- Dial mode -----------------------------------------------------------
# "simulation" (default) = fake calls, free, nothing rings.
# "real"                 = dial through Vapi.
DIAL_MODE=simulation

# --- Vapi (only needed when DIAL_MODE=real) ------------------------------
# VAPI_API_KEY is a SECRET — set it here / in Render, never in code or git.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# Optional: shared secret to verify Vapi's webhook calls. If set here, set the
# same value as the secret on your Vapi number's Server URL.
VAPI_WEBHOOK_SECRET=

# When "true", each call uses that client's own `instructions` as its system
# prompt (the 50-client mechanism). Leave false for your first real test so it
# uses the assistant you already tuned in the Vapi dashboard.
USE_CLIENT_INSTRUCTIONS=false
